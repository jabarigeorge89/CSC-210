# world.config — initial conditions for the ecosystem simulation.
# Blank lines and lines starting with '#' are ignored.
# Each line is a series of key=value tokens separated by spaces.

# world dimensions (must come first)
rows=20 cols=40

# creatures: species=<Class> name=<Name> x=<col> y=<row>
species=Bird name=Eagle x=5 y=2
species=Bird name=Robin x=15 y=8
species=Fish name=Nemo x=20 y=5
species=Fish name=Dory x=30 y=12
species=Mammal name=Wolf x=10 y=15
species=Mammal name=Bear x=35 y=3

# Add lines for your own Plant subclasses once you have written them, e.g.:
 species=Tree name=Oak x=5 y=10
 species=Flower name=Rose x=10 y=6
 species=Moss name=Patch x=1 y=1

# Stretch: the optional count key creates several creatures at once —
# the first at (x, y), the rest at random empty tiles:
# species=Bird count=5 x=3 y=4
